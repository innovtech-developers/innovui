{
  "name": "@innovui/react",
  "version": "1.1.4",
  "description": "Biblioteca de componentes React do design system InnovUI.",
  "keywords": [
    "react",
    "react-19",
    "design-system",
    "components",
    "ui",
    "typescript",
    "tailwindcss",
    "accessibility",
    "dark-mode",
    "innovui",
    "comhub"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://innovui.innovtechsolutions.com.br",
  "bugs": {
    "url": "https://github.com/innovtech-developers/innovui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/innovtech-developers/innovui.git",
    "directory": "packages/react"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "scripts": {
    "build": "tsdown && pnpm build:css",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/styles.css --minify",
    "dev": "tsdown --watch & tailwindcss -i src/styles/index.css -o dist/styles.css --watch & wait",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.13.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vitest": "^5.0.3"
  }
}
